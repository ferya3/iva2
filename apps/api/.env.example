APP_NAME=Cognitest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Front-ends allowed to call the API (CORS)
CLINIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
PLAYER_DEEP_LINK_SCHEME=cognitest

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# The application connects as the non-owner runtime role so PostgreSQL
# Row-Level Security applies; migrations run as the owner (DB_MIGRATION_*).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cognitest
DB_USERNAME=cognitest_app
DB_PASSWORD=secret
DB_MIGRATION_USERNAME=cognitest
DB_MIGRATION_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
REPORTS_DISK=reports

# Sanctum personal access tokens (minutes)
SANCTUM_EXPIRATION=720

# Scoring engine (Node CLI bundled from packages/scoring-engine)
SCORING_NODE_BINARY=node
SCORING_CLI_PATH=../../packages/scoring-engine/dist/cli.mjs
SCORING_TIMEOUT=120

# Headless Chromium used for PDF reports
PDF_CHROMIUM_BINARY=chromium-headless-shell
PDF_TIMEOUT=60

# Player invites
INVITE_TTL_HOURS=72
PLAYER_TOKEN_TTL_HOURS=12
