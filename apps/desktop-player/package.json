{
  "name": "@cognitest/desktop-player",
  "version": "0.1.0",
  "private": true,
  "description": "Cognitest desktop assessment player (Electron)",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@cognitest/assessment-engine": "workspace:*",
    "@cognitest/audio-engine": "workspace:*",
    "@cognitest/calibration": "workspace:*",
    "@cognitest/event-recorder": "workspace:*",
    "@cognitest/shared-types": "workspace:*",
    "@cognitest/stimulus-renderer": "workspace:*",
    "@cognitest/timing-core": "workspace:*",
    "@cognitest/validation": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vazirmatn": "33.0.3",
    "@cognitest/ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
