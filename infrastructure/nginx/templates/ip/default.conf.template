# IP mode (no domain yet): one address, self-signed certificate.
#   https://${PUBLIC_HOST}/          clinic panel
#   https://${PUBLIC_HOST}/api/v1/   API (desktop player + panels' BFF)
#   https://${PUBLIC_HOST}:8443/     admin panel (allow-listed addresses only)
# Switch to the domain layout later by re-running scripts/install.sh --domain.

limit_req_zone $binary_remote_addr zone=api_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80 default_server;
  server_name _;
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;
  include /etc/nginx/snippets/tls.conf;
  # No HSTS: browsers ignore it for IP addresses and the certificate is self-signed.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  server_tokens off;
  client_max_body_size 2m;

  # --- Laravel API ---------------------------------------------------------
  root /var/www/api/public;
  location = /api/v1/auth/login { limit_req zone=api_auth burst=5 nodelay; try_files $uri /index.php?$query_string; }
  location = /api/v1/player/join { limit_req zone=api_auth burst=5 nodelay; try_files $uri /index.php?$query_string; }
  location /api/v1/ { limit_req zone=api_general burst=60 nodelay; try_files $uri /index.php?$query_string; }
  location = /index.php {
    internal;
    fastcgi_pass api:9000;
    fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
    include fastcgi_params;
    fastcgi_read_timeout 60s;
    fastcgi_hide_header X-Powered-By;
  }

  # --- Clinic panel (everything else, incl. its own /api/reports routes) ----
  location /_next/static/ {
    proxy_pass http://clinic-web:3000;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
  location / {
    proxy_pass http://clinic-web:3000;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# --- Platform admin ---------------------------------------------------------
server {
  listen 8443 ssl;
  http2 on;
  server_name _;
  include /etc/nginx/snippets/tls.conf;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  server_tokens off;

  # admin-allowlist.local.conf is written by scripts/install.sh (git-ignored).
  include /etc/nginx/snippets/admin-allowlist*.conf;
  deny all;
  error_page 497 =301 https://$host:8443$request_uri;

  location / {
    proxy_pass http://admin-web:3000;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
