# Edge proxy (template: ${DOMAIN} is substituted at container start).
# TLS certificates are mounted at /etc/nginx/certs
# (copied from certbot by scripts/install.sh, or self-signed).

limit_req_zone $binary_remote_addr zone=api_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80 default_server;
  server_name _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# --- API (Laravel / PHP-FPM) -------------------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name api.${DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/security-headers.conf;

  root /var/www/api/public;
  index index.php;
  # Event batches are capped at 1 MB by the API; allow some headroom.
  client_max_body_size 2m;

  location = /api/v1/auth/login { limit_req zone=api_auth burst=5 nodelay; try_files $uri /index.php?$query_string; }
  location = /api/v1/player/join { limit_req zone=api_auth burst=5 nodelay; try_files $uri /index.php?$query_string; }
  location /horizon { allow 10.0.0.0/8; allow 127.0.0.1; deny all; try_files $uri /index.php?$query_string; }
  location / { limit_req zone=api_general burst=60 nodelay; try_files $uri /index.php?$query_string; }

  location ~ \.php$ {
    fastcgi_pass api:9000;
    fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    include fastcgi_params;
    fastcgi_read_timeout 60s;
    fastcgi_hide_header X-Powered-By;
  }
  location ~ /\. { deny all; }
}

# --- Clinic panel --------------------------------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name clinic.${DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/security-headers.conf;

  location /_next/static/ {
    proxy_pass http://clinic-web:3000;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
  location / {
    proxy_pass http://clinic-web:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# --- Platform admin (restricted network) ---------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name admin.${DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/security-headers.conf;

  # Only reachable from the office VPN / allow-listed addresses.
  # admin-allowlist.local.conf is written by scripts/install.sh (git-ignored).
  include /etc/nginx/snippets/admin-allowlist*.conf;
  deny all;

  location / {
    proxy_pass http://admin-web:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
