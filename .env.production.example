# Copy to .env.production and fill in. Never commit the real file.
DOMAIN=cognitest.ir
VERSION=latest
APP_KEY=                       # php artisan key:generate --show
POSTGRES_SUPERUSER_PASSWORD=
COGNITEST_OWNER_PASSWORD=
COGNITEST_APP_PASSWORD=
REDIS_PASSWORD=
TLS_CERT_DIR=./infrastructure/nginx/certs   # scripts/install.sh copies certbot certificates here
NPM_REGISTRY=https://registry.npmjs.org     # npm mirror for image builds on restricted networks
