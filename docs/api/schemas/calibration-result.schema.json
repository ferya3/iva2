{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "display": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "refresh_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_interval_mean_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_interval_sd_ms": {
          "type": "number",
          "minimum": 0
        },
        "frame_interval_p99_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dropped_frame_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "samples",
        "refresh_rate_hz",
        "frame_interval_mean_ms",
        "frame_interval_sd_ms",
        "frame_interval_p99_ms",
        "dropped_frame_ratio"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dispatch_latency_mean_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatch_latency_p95_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "samples",
        "dispatch_latency_mean_ms",
        "dispatch_latency_p95_ms"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "base_latency_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_latency_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "sample_rate",
        "base_latency_ms",
        "output_latency_ms"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "display",
    "input",
    "audio",
    "verdict",
    "reasons"
  ],
  "additionalProperties": false
}
