{
  "name": "@cognitest/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime schemas (zod) for the data contracts between player, API and panels",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "schema:export": "tsx scripts/export-json-schema.ts"
  },
  "dependencies": {
    "@cognitest/shared-types": "workspace:*",
    "zod": "4.6.7"
  }
}
